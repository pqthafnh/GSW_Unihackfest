# ============================================
# Supabase: browser-safe configuration
# ============================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================================
# Supabase: server-only secret
# Never expose this variable in Client Components
# or rename it with the NEXT_PUBLIC_ prefix.
# ============================================

SUPABASE_SECRET_KEY=

# ============================================
# Solana Devnet
# ============================================

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ============================================
# Server-only provider configuration
# ============================================

AI_API_KEY=
AI_MODEL=
METAPLEX_MINT_AUTHORITY_SECRET=
RECEIPT_METADATA_BASE_URL=
CRON_SECRET=

# ============================================
# Application configuration
# ============================================

PLATFORM_FEE_BPS=500
ACCEPTED_TOKEN_MINT=
MAX_UPLOAD_BYTES=5242880
SUPABASE_PRIVATE_BUCKET=deliverables